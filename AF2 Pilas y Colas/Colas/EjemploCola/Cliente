
public class Cliente {

    private String nombre;
    private int productos;
    private int turno;

    public Cliente(String nombre, int productos, int turno) {
        this.nombre = nombre;
        this.productos = productos;
        this.turno = turno;
    }

    public String getNombre() {
        return nombre;
    }

    public int getProductos() {
        return productos;
    }

    public int getTurno() {
        return turno;
    }
}
