
import java.util.LinkedList;
import java.util.Queue;
import java.util.Scanner;

public class Problema103 {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Cola de clientes que estan comprando con su carrito.
        Queue<Integer> comprando = new LinkedList<>();

        // Cola de clientes que terminaron de comprar y esperan pagar.
        Queue<Integer> caja1 = new LinkedList<>();
        Queue<Integer> caja2 = new LinkedList<>();
        Queue<Integer> caja3 = new LinkedList<>();

        // Cola de clientes que esperan que se libere un carrito.
        Queue<Integer> esperandoCarrito = new LinkedList<>();

        // Al inicio hay 25 carritos disponibles.
        int carritosDisponibles = 25;

        // Cada cliente recibe un numero identificador.
        int siguienteCliente = 1;

        int opcion;

        do {
            System.out.println("\n--- SUPERMERCADO ---");
            System.out.println("1. Llega un cliente");
            System.out.println("2. Cliente termina de comprar");
            System.out.println("3. Cliente paga en una caja");
            System.out.println("4. Mostrar estado");
            System.out.println("0. Salir");
            System.out.print("Seleccione una opcion: ");

            opcion = sc.nextInt();

            switch (opcion) {

                case 1:
                    // Llega un cliente nuevo.
                    int cliente = siguienteCliente;
                    siguienteCliente++;

                    // Si hay carritos, el cliente puede comprar.
                    if (carritosDisponibles > 0) {
                        carritosDisponibles--;
                        comprando.add(cliente);

                        System.out.println("Cliente " + cliente
                                + " recibe un carrito.");
                    } else {
                        // Si no hay carritos, el cliente debe esperar.
                        esperandoCarrito.add(cliente);

                        System.out.println("No hay carritos. Cliente "
                                + cliente + " queda esperando.");
                    }
                    break;

                case 2:
                    // Un cliente termina de comprar.
                    if (comprando.isEmpty()) {
                        System.out.println("No hay clientes comprando.");
                    } else {
                        cliente = comprando.remove();

                        // Buscamos la caja con menos clientes.
                        int menor = caja1.size();

                        if (caja2.size() < menor) {
                            menor = caja2.size();
                        }

                        if (caja3.size() < menor) {
                            menor = caja3.size();
                        }

                        // Si hay empate, se elige la primera caja que tenga la menor cantidad de clientes.
                        if (caja1.size() == menor) {
                            caja1.add(cliente);
                            System.out.println("Cliente " + cliente
                                    + " pasa a la caja 1.");
                        } else if (caja2.size() == menor) {
                            caja2.add(cliente);
                            System.out.println("Cliente " + cliente
                                    + " pasa a la caja 2.");
                        } else {
                            caja3.add(cliente);
                            System.out.println("Cliente " + cliente
                                    + " pasa a la caja 3.");
                        }
                    }
                    break;

                case 3:
                    // El cliente de la caja elegida paga.
                    System.out.print("Numero de caja (1, 2 o 3): ");
                    int numeroCaja = sc.nextInt();

                    Queue<Integer> caja = null;

                    if (numeroCaja == 1) {
                        caja = caja1;
                    } else if (numeroCaja == 2) {
                        caja = caja2;
                    } else if (numeroCaja == 3) {
                        caja = caja3;
                    }

                    if (caja == null) {
                        System.out.println("Caja invalida.");
                    } else if (caja.isEmpty()) {
                        System.out.println("La caja esta vacia.");
                    } else {
                        cliente = caja.remove();

                        System.out.println("Cliente " + cliente
                                + " ha pagado.");

                        // El carrito queda libre al pagar.
                        carritosDisponibles++;

                        // Si alguien esperaba un carrito,
                        // se le entrega inmediatamente.
                        if (!esperandoCarrito.isEmpty()) {
                            int siguiente = esperandoCarrito.remove();

                            carritosDisponibles--;
                            comprando.add(siguiente);

                            System.out.println("Cliente " + siguiente
                                    + " recibe el carrito liberado.");
                        }
                    }
                    break;

                case 4:
                    // Mostramos el estado actual del supermercado.
                    System.out.println("\nCarritos disponibles: "
                            + carritosDisponibles);

                    System.out.println("Clientes comprando: "
                            + comprando);

                    System.out.println("Esperando carrito: "
                            + esperandoCarrito);

                    System.out.println("Caja 1: " + caja1);
                    System.out.println("Caja 2: " + caja2);
                    System.out.println("Caja 3: " + caja3);
                    break;

                case 0:
                    System.out.println("Fin del programa.");
                    break;

                default:
                    System.out.println("Opcion invalida.");
            }

        } while (opcion != 0);

        sc.close();
    }
}
